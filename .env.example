# Copiez ce fichier en `.env` avant `docker compose up -d`.

# Compte administrateur créé au tout premier démarrage (base vide).
KALENDRA_ADMIN_USER=admin
KALENDRA_ADMIN_PASSWORD=changez-moi-vraiment

TZ=Europe/Paris

# Derrière un reverse proxy uniquement : lit l'adresse du client dans
# X-Forwarded-For, sans quoi le freinage des connexions bloquerait tout le
# monde à la fois.
# KALENDRA_TRUST_PROXY=true

# Espace maximal par compte, en octets (0 ou absent : illimité).
# KALENDRA_QUOTA_BYTES=104857600
