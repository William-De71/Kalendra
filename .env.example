# Copiez ce fichier en `.env` avant `docker compose up -d`.

# Compte administrateur créé au tout premier démarrage (base vide).
KALENDRA_ADMIN_USER=admin
KALENDRA_ADMIN_PASSWORD=changez-moi-vraiment

# URL publique telle que vue par les clients : sert à afficher les bonnes
# URLs CalDAV et de flux ICS dans l'interface d'administration.
KALENDRA_PUBLIC_URL=https://cal.example.org

TZ=Europe/Paris
